# Cesta k souboru databáze. Výchozí hodnota je ./data/flipcore.db, tento soubor
# stačí smazat a vznikne prázdná databáze, která po `pnpm db:seed` naplní ukázkovými daty.
#
# Na budoucím přechodu na Postgres sem patří connection string, například:
# postgresql://uzivatel:heslo@localhost:5432/flipcore
DATABASE_URL=./data/flipcore.db
